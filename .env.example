# Entra app registration for this site. Use a single-tenant app in The Launch Box tenant.
# Platform: single-page application.
# Redirect URI: this site's origin, such as http://localhost:5174 and the Azure hostname.
VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=82f56c4e-888b-4ac4-a433-0768b1724101

# BambooHR figures live in the Launchbox MySQL database on Amazon RDS.
# Leave these blank to serve the saved extract instead of a live query.
KTT_MYSQL_HOST=
KTT_MYSQL_PORT=3306
KTT_MYSQL_USER=
KTT_MYSQL_PASSWORD=
