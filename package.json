    "verify": "tsc --noEmit && tsx scripts/check.ts"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.10.0",
    "clsx": "^2.1.1",
    "jose": "^6.1.0",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.18.1",
    "recharts": "^2.15.4",
    "tailwind-merge": "^3.0.2",
    "tsx": "^4.19.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.0.9",
    "typescript": "~5.7.3",
    "vite": "^6.2.0"
  }
