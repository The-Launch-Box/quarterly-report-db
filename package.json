{
  "name": "q3-boards",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Q3 portfolio boards. Edit Q4 figures by company, then graph them as bar, pie, or scatter.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
